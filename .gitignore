session_state.json
codex_pty_debug.log
prompt_improvements.json

# --- Unrelated nested project accidentally sitting in this folder ---
codex/

# --- Python noise ---
__pycache__/
*.pyc

# --- Local backups made during git migration / editing ---
*.bak
*.bak.*
